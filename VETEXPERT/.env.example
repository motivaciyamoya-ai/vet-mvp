# Базовый URL NestJS API (без завершающего слэша).
# Оставьте пустым в разработке: Vite проксирует /api на http://localhost:3000 (см. vite.config.ts).
# Если указываете URL с уже приписанным /api — фронт сам уберёт дубль в пути /api/…
# Для продакшена или если фронт открыт не через Vite dev server:
# VITE_API_BASE_URL=http://localhost:3000

# Если статика загрузок ждёт на другом origin (SPA на app.ru, файлы на api.ru):
# VITE_ASSET_ORIGIN=https://api.example.com

VITE_API_BASE_URL=
VITE_ASSET_ORIGIN=
