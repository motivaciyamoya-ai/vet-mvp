DATABASE_URL="postgresql://vet:vet@localhost:5432/vetmvp?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long!"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
PORT=3000

# AI инструменты (анализ анамнеза/рентген/УЗИ).
# Бесплатный вариант (локально на сервере): Ollama
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_VISION_MODEL="llava:7b"

# Платный вариант: OpenAI (если захотите включить)
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
