DATABASE_URL="postgresql://vet:vet@localhost:5432/vetmvp?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long!"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
PORT=3000
TRUST_PROXY=1

# CORS: список origin через запятую. Если пусто — в production будет взят FRONTEND_URL (если задан).
# CORS_ORIGINS="https://your-domain.example"

# Swagger в production по умолчанию выключен. Включить: ENABLE_SWAGGER=true
# ENABLE_SWAGGER=false

# Refresh token по умолчанию в production уходит в httpOnly cookie (vetmvp_rt).
# Для совместимости со старым фронтом можно отключить (НЕ рекомендуется):
# REFRESH_HTTP_ONLY_COOKIE=false
# Чтобы не возвращать refreshToken в JSON (только cookie): REFRESH_TOKEN_IN_JSON=false

# AI инструменты (анализ анамнеза/рентген/УЗИ).
# Бесплатный вариант (локально на сервере): Ollama
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_VISION_MODEL="llava:7b"

# База ссылок в письмах (подтверждение email и т. д.). В production — публичный URL фронта, например https://vetconnect.online
# FRONTEND_URL="https://vetconnect.online"

# Email (SMTP): при заданном SMTP_HOST письма с подтверждением email уходят на адрес пользователя.
# ALERT_EMAIL_TO — только получатель служебных алертов (вход админа, всплеск логинов и т. д.).
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@your-domain.example"
# ALERT_EMAIL_TO="security@your-domain.example"

# Платный вариант: OpenAI (если захотите включить)
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# Совместимый с OpenAI API (Azure / прокси): база без завершающего слэша
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Явное включение/выключение пользовательского медицинского анализа (эндпоинт /api/ai/medical-analyzer)
# AI_MEDICAL_ANALYZER_ENABLED=true
